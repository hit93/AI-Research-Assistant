# ==========================================
# RESEARCH ASSISTANT CONFIGURATION
# ==========================================

# Primary LLM: Groq (Free tier available at https://console.groq.com)
GROQ_API_KEY=your_free_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile
VERIFIER_MODEL=openai/gpt-oss-120b

# Web Search: Tavily API (Free tier 1000 credits/mo at https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here
SEARCH_ENGINE=tavily

# Academic Research: ArXiv (100% Free - NO API key required)

# App Settings
LOG_LEVEL=INFO
REPORTS_DIR=data/reports
CACHE_DIR=data/cache
